{
  "name": "lumendeck",
  "private": true,
  "version": "0.2.32",
  "description": "Wallpaper-driven RGB lighting, live wallpapers and screen stickers for Windows.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-versions.mjs",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:check": "node scripts/generate-changelog.mjs --check",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "i18next": "^26.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
