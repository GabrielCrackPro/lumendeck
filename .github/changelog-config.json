{
  "categories": [
    {
      "title": "## Fixes",
      "labels": ["fix"]
    },
    {
      "title": "## Improvements",
      "labels": ["feat", "perf", "refactor"]
    },
    {
      "title": "## Documentation",
      "labels": ["docs"]
    },
    {
      "title": "## Build & CI",
      "labels": ["build", "ci"]
    },
    {
      "title": "## Chores",
      "labels": ["chore", "test"]
    },
    {
      "title": "## Other",
      "labels": ["other"]
    }
  ],
  "label_extractor": [
    {
      "pattern": "^(\\w+)",
      "on_property": "title",
      "method": "regex"
    }
  ],
  "tag_prefix": "v",
  "template": "#{{CHANGELOG}}\n\n**Full changelog:** https://github.com/GabrielCrackPro/lumendeck/compare/#{{FROM_TAG}}...#{{TO_TAG}}",
  "pr_template": "- #{{TITLE}}",
  "empty_template": "- No notable changes."
}
